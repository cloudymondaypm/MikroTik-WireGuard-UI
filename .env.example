# Web login
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-unique-password-at-least-12-chars
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
SESSION_HOURS=12
APP_PORT=80

# MikroTik RouterOS REST API
MIKROTIK_HOST=10.10.1.10
MIKROTIK_USERNAME=wg-ui-api
MIKROTIK_PASSWORD=replace-me
MIKROTIK_REST_SCHEME=https
MIKROTIK_REST_PORT=8443
# Set false only when the router uses a pinned/trusted self-signed certificate
# that is otherwise validated out-of-band.
MIKROTIK_VERIFY_TLS=false
MIKROTIK_WG_INTERFACE=wireguard1

# Client tunnel settings
CLIENT_POOL_CIDR=10.10.16.0/24
WG_ENDPOINT_HOST=heb08wr89w5.sn.mynetname.net
WG_CLIENT_DNS=10.10.1.15
WG_CLIENT_ALLOWED_IPS=10.10.1.0/24
WG_PERSISTENT_KEEPALIVE=25
