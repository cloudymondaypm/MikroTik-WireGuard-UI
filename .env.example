# Optional Docker Compose settings only.
# Router credentials and WireGuard settings are configured in the web UI
# and stored in the private Docker data volume (wg-ui-data).
APP_PORT=80

# Advanced users may also provide backend settings as environment variables.
# Do not commit real credentials, private hostnames, or deployment-specific values.
# APP_USERNAME=admin
# APP_PASSWORD=
# JWT_SECRET=
# COOKIE_SECURE=false
# SESSION_HOURS=12
# MIKROTIK_HOST=
# MIKROTIK_USERNAME=
# MIKROTIK_PASSWORD=
# MIKROTIK_REST_SCHEME=https
# MIKROTIK_REST_PORT=443
# MIKROTIK_VERIFY_TLS=true
# MIKROTIK_WG_INTERFACE=wireguard1
# CLIENT_POOL_CIDR=10.120.0.0/24
# WG_ENDPOINT_HOST=
# WG_CLIENT_DNS=1.1.1.1
# WG_CLIENT_ALLOWED_IPS=0.0.0.0/0
# WG_PERSISTENT_KEEPALIVE=25
